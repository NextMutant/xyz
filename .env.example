# Xeno Monorepo Environment Variables

# This project uses separate .env files for each application.
# Please see the .env.example files in the following directories:

# 1. CRM Backend: apps/crm/.env.example
# 2. Web Frontend: apps/web/.env.example
# 3. Channel Simulator: apps/channel-simulator/.env.example

# Quick Reference (Default Local Setup):
# CRM_BACKEND_URL: http://localhost:4000
# WEB_FRONTEND_URL: http://localhost:3000
# CHANNEL_SIMULATOR_URL: http://localhost:4001
