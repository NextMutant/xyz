# Git ignore rules for the entire monorepo

# Node modules
node_modules/
**/node_modules/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.development
.env.test
*.env

# Next.js build output
.next/
**/.next/

# Prisma generated client
apps/crm/node_modules/.prisma/

# Build outputs
dist/
build/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Personal reference files (not for public repo)
explain.md
apps/*/explain.md
